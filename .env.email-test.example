# ---------------------------------------------------------------------------
# StreamingHub – email test environment (NEVER commit the filled-in copy)
#
# Copy to .env.email-test, add a Resend test/sending key and load it into the
# shell before starting the app:
#
#   cp .env.email-test.example .env.email-test
#   set -a; . ./.env.email-test; set +a
#   npm run dev
#
# In a second terminal (same variables):
#   set -a; . ./.env.email-test; set +a
#   npm run email:resend-test
#
# The live test only mails Resend's simulated recipients:
# delivered@resend.dev, bounced@resend.dev, complained@resend.dev
# ---------------------------------------------------------------------------

APP_URL=http://127.0.0.1:3000
SMOKE_BASE_URL=http://127.0.0.1:3000

EMAIL_PROVIDER=resend
# Use a dedicated test key with sending permission only.
EMAIL_API_KEY=
# Either a verified domain address or onboarding@resend.dev for first tests.
EMAIL_FROM=StreamingHub <onboarding@resend.dev>
EMAIL_REPLY_TO=service@streaminghub.org
CONTACT_TO_EMAIL=service@streaminghub.org

# Signing secret of the webhook endpoint (Resend → Webhooks).
# Required for /api/webhooks/resend; leave empty to test the "not configured" path.
EMAIL_WEBHOOK_SECRET=

# Keep 0 for the live test: the script must observe real provider responses.
SHOW_DEV_EMAIL_LINKS=0
