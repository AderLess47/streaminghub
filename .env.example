# ---------------------------------------------------------------------------
# StreamingHub – environment configuration
# Copy to .env.local (never commit real secrets) and fill in the values.
# ---------------------------------------------------------------------------

# Public base URL. Used for absolute links in emails and canonical metadata.
APP_URL=https://streaminghub.org
SUPPORT_EMAIL=service@streaminghub.org

# SQLite database file (persistent volume in production).
DATABASE_PATH=./data/streaminghub.db
# Session lifetime in days.
SESSION_DAYS=30

# Initial administrator. Created once on first start, then ignored.
# Leave empty in production until you are ready to create the admin account.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Transactional email (Resend-compatible HTTP API) ----------------------
# Without a key, messages stay in the admin outbox; nothing is reported as sent.
EMAIL_PROVIDER=resend
EMAIL_API_KEY=
EMAIL_FROM=StreamingHub <service@streaminghub.org>
EMAIL_REPLY_TO=service@streaminghub.org
# Signing secret for delivery events (Resend webhook -> /api/webhooks/resend).
EMAIL_WEBHOOK_SECRET=
# Override only for staging proxies or the local stub provider in tests.
# EMAIL_API_BASE=https://api.resend.com
# EMAIL_TIMEOUT_MS=8000
CONTACT_TO_EMAIL=service@streaminghub.org
# Local development only: show verification/reset links in the UI.
SHOW_DEV_EMAIL_LINKS=0

# --- Billing (Stripe-compatible, integration point) ------------------------
# Without these values the web checkout returns 503 and never claims a payment.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
# Override only for a Stripe-compatible proxy or the local stub in tests.
# STRIPE_API_BASE=https://api.stripe.com
# STRIPE_TIMEOUT_MS=10000
# Amazon Appstore listing (Amazon In-App Purchasing handles billing there).
AMAZON_STORE_URL=

# --- App downloads (public R2 objects, only released builds) ---------------
DOWNLOAD_FIRE_TV_URL=https://downloads.streaminghub.org/streaminghub-1.2.2.apk?v=f14b07b561d07fce6a7c1002616803379da6c62b35aeafe4d6d3b5a130dd0d85
DOWNLOAD_ANDROID_TV_URL=https://downloads.streaminghub.org/streaminghub-1.2.2.apk?v=f14b07b561d07fce6a7c1002616803379da6c62b35aeafe4d6d3b5a130dd0d85
DOWNLOAD_ANDROID_MOBILE_URL=https://downloads.streaminghub.org/streaminghub-1.2.2.apk?v=f14b07b561d07fce6a7c1002616803379da6c62b35aeafe4d6d3b5a130dd0d85

# --- Android release upload (scripts/release-apk.mjs) ----------------------
# Public bucket/domain; credentials belong in the shell or .env.release.
R2_BUCKET=streaminghub-downloads
R2_PUBLIC_BASE=https://downloads.streaminghub.org
# Set CLOUDFLARE_ACCOUNT_ID and CLOUDFLARE_API_TOKEN for non-interactive
# uploads, or run `npx wrangler login` once.

# --- Operator data for the legal notice ------------------------------------
# Placeholders are shown until these are set. Do not invent company data.
OPERATOR_LEGAL_NAME=
OPERATOR_REPRESENTATIVE=
OPERATOR_STREET=
OPERATOR_POSTAL_CODE=
OPERATOR_CITY=
OPERATOR_COUNTRY=Deutschland
OPERATOR_EMAIL=service@streaminghub.org
OPERATOR_PHONE=
OPERATOR_VAT_ID=
OPERATOR_REGISTER_COURT=
OPERATOR_REGISTER_NUMBER=
