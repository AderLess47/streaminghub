{
  "name": "streaminghub",
  "version": "1.0.0",
  "private": true,
  "description": "StreamingHub – IPTV player product website, customer portal and admin console",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "predev": "node scripts/release-sync.mjs --best-effort",
    "build": "next build",
    "prebuild": "node scripts/release-sync.mjs --best-effort",
    "start": "next start",
    "start:standalone": "node .next/standalone/server.js",
    "typecheck": "tsc --noEmit",
    "test:download-page": "node --test scripts/download-page.test.mjs",
    "test:release-sync": "node --test scripts/release-sync.test.mjs",
    "test:db-migration": "node --test scripts/db-migration.test.mjs",
    "test:amazon-iap": "node --experimental-strip-types --test src/lib/amazon-iap.test.ts src/lib/amazon-subscriptions.test.ts src/lib/amazon-rtn.test.ts src/lib/amazon-sync.test.ts",
    "test:progress": "node --experimental-strip-types --test src/lib/watch-progress.test.ts",
    "test:contracts": "node --experimental-strip-types --import ./scripts/register-ts-extensions.mjs --test src/lib/contract-requests.test.ts",
    "amazon:sync": "node --env-file-if-exists=.env.local scripts/amazon-sync.mjs",
    "db:init": "node scripts/init-db.mjs",
    "release:apk": "node --env-file-if-exists=.env.local --env-file-if-exists=.env.release scripts/release-apk.mjs",
    "release:sync": "node scripts/release-sync.mjs",
    "smoke": "node --env-file-if-exists=.env.local scripts/smoke-test.mjs",
    "bfsg:review": "node scripts/bfsg-review.mjs",
    "smoke:deploy": "node scripts/deploy-smoke.mjs",
    "admin:smoke": "node scripts/admin-smoke.mjs",
    "email:smoke": "node --env-file-if-exists=.env.local scripts/email-smoke.mjs",
    "email:resend-test": "node scripts/resend-live-test.mjs",
    "stripe:smoke": "node scripts/stripe-smoke.mjs",
    "stripe:live-test": "node scripts/stripe-live-test.mjs",
    "test:apple-iap": "node --experimental-strip-types --import ./scripts/register-ts-extensions.mjs --test src/lib/apple-iap.test.ts src/lib/apple-subscriptions.test.ts",
    "test:subscription-mails": "node --experimental-strip-types --import ./scripts/register-ts-extensions.mjs --test src/lib/subscription-mails.test.ts",
    "test:api": "node scripts/run-api-tests.mjs"
  },
  "dependencies": {
    "next": "^15.5.7",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.14",
    "@types/node": "22.18.6",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "tailwindcss": "4.1.14",
    "typescript": "5.9.2",
    "wrangler": "^4.160.0"
  },
  "allowScripts": {
    "@tailwindcss/oxide@4.1.14": true,
    "sharp@0.34.5": true
  }
}
