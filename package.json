{
  "name": "streaminghub",
  "version": "1.0.0",
  "private": true,
  "description": "StreamingHub – IPTV player product website, customer portal and admin console",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "predev": "node scripts/release-sync.mjs --best-effort",
    "build": "next build",
    "prebuild": "node scripts/release-sync.mjs --best-effort",
    "start": "next start",
    "start:standalone": "node .next/standalone/server.js",
    "typecheck": "tsc --noEmit",
    "check:app-versions": "node scripts/check-app-versions.mjs",
    "test:download-page": "node --test scripts/download-page.test.mjs",
    "test:release-sync": "node --test scripts/release-sync.test.mjs",
    "test:db-migration": "node --test scripts/db-migration.test.mjs",
    "test:amazon-iap": "node --experimental-strip-types --test src/lib/amazon-iap.test.ts src/lib/amazon-subscriptions.test.ts src/lib/amazon-rtn.test.ts src/lib/amazon-sync.test.ts",
    "test:progress": "node --experimental-strip-types --test src/lib/watch-progress.test.ts",
    "test:entitlements": "node --experimental-strip-types --import ./scripts/register-ts-extensions.mjs --test src/lib/entitlements.test.ts src/lib/pricing.test.ts src/lib/flags.test.ts",
    "test:trial": "node --experimental-strip-types --import ./scripts/register-ts-extensions.mjs --test src/lib/trial.test.ts",
    "test:trial-jobs": "node --experimental-strip-types --import ./scripts/register-ts-extensions.mjs --test src/lib/trial-jobs.test.ts",
    "test:device-cleanup": "node --experimental-strip-types --import ./scripts/register-ts-extensions.mjs --test src/lib/device-cleanup.test.ts",
    "test:backup": "node --experimental-strip-types --import ./scripts/register-ts-extensions.mjs --test src/lib/backup.test.ts",
    "test:retention": "node --experimental-strip-types --import ./scripts/register-ts-extensions.mjs --test src/lib/retention.test.ts",
    "test:checkout-consent": "node --experimental-strip-types --test src/lib/checkout-consent.test.ts",
    "test:contracts": "node --experimental-strip-types --import ./scripts/register-ts-extensions.mjs --test src/lib/contract-requests.test.ts",
    "amazon:sync": "node --env-file-if-exists=.env.local scripts/amazon-sync.mjs",
    "trial:jobs": "node --env-file-if-exists=.env.local scripts/trial-jobs.mjs",
    "db:init": "node scripts/init-db.mjs",
    "release:apk": "node --env-file-if-exists=.env.local --env-file-if-exists=.env.release scripts/release-apk.mjs",
    "release:sync": "node scripts/release-sync.mjs",
    "smoke": "node --env-file-if-exists=.env.local scripts/smoke-test.mjs",
    "bfsg:review": "node scripts/bfsg-review.mjs",
    "smoke:deploy": "node scripts/deploy-smoke.mjs",
    "admin:smoke": "node scripts/admin-smoke.mjs",
    "email:smoke": "node --env-file-if-exists=.env.local scripts/email-smoke.mjs",
    "email:resend-test": "node scripts/resend-live-test.mjs",
    "stripe:smoke": "node scripts/stripe-smoke.mjs",
    "stripe:live-test": "node scripts/stripe-live-test.mjs",
    "test:apple-iap": "node --experimental-strip-types --import ./scripts/register-ts-extensions.mjs --test src/lib/apple-iap.test.ts src/lib/apple-subscriptions.test.ts",
    "test:subscription-mails": "node --experimental-strip-types --import ./scripts/register-ts-extensions.mjs --test src/lib/subscription-mails.test.ts",
    "test:api": "node scripts/run-api-tests.mjs",
    "test:store-api": "node scripts/run-store-api-tests.mjs",
    "test:stripe-webhook": "node scripts/run-stripe-webhook-tests.mjs && node scripts/run-stripe-webhook-unconfigured.mjs",
    "test:mail-outbox": "node --experimental-strip-types --import ./scripts/register-ts-extensions.mjs --test src/lib/mail-outbox.test.ts && node --experimental-strip-types --import ./scripts/register-ts-extensions.mjs --test src/lib/mail-outbox-unconfigured.test.ts",
    "test:resend-webhook": "node scripts/run-resend-webhook-tests.mjs configured && node scripts/run-resend-webhook-tests.mjs unconfigured",
    "test:admin-suppression": "node scripts/run-admin-suppression-tests.mjs",
    "test:admin-retry": "node scripts/run-admin-retry-tests.mjs",
    "test:password-reset": "node scripts/run-password-reset-tests.mjs",
    "test:email-verification": "node scripts/run-email-verification-tests.mjs",
    "test:mfa-login": "node scripts/run-mfa-login-tests.mjs",
    "test:session-logout": "node scripts/run-session-logout-tests.mjs",
    "test:pairing": "node scripts/run-pairing-tests.mjs",
    "test:device-revoke": "node scripts/run-device-revoke-tests.mjs",
    "test:data-requests": "node scripts/run-data-requests-tests.mjs",
    "test:change-password": "node scripts/run-change-password-tests.mjs",
    "test:support-tickets": "node scripts/run-support-tickets-tests.mjs",
    "test:withdrawal-cancellation": "node scripts/run-withdrawal-cancellation-tests.mjs",
    "test:cookie-consent": "node --test scripts/cookie-consent.test.mjs",
    "test:contact-form": "node scripts/run-contact-form-tests.mjs",
    "test:admin-contacts": "node scripts/run-admin-contacts-tests.mjs",
    "test:audit-retention": "node scripts/run-audit-retention-tests.mjs",
    "test:staging-canary": "node --test scripts/staging-canary-assert.test.mjs scripts/staging-canary.test.mjs scripts/staging-canary-sweep.test.mjs scripts/staging-canary-db-sweep.test.mjs scripts/staging-canary-db-preflight-summary.test.mjs",
    "test:public-cache": "node --test scripts/public-html-cache-proxy.test.mjs",
    "test:red-run-issue": "node --test scripts/red-run-issue.test.mjs",
    "staging:canary": "node scripts/staging-canary.mjs",
    "staging:canary:sweep": "node scripts/staging-canary-sweep.mjs",
    "staging:canary:db-sweep": "node scripts/staging-canary-db-sweep.mjs",
    "retention:purge": "node scripts/contact-retention.mjs",
    "retention:audit": "node scripts/audit-retention.mjs"
  },
  "dependencies": {
    "next": "^15.5.7",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.14",
    "@types/node": "22.18.6",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "tailwindcss": "4.1.14",
    "typescript": "5.9.2",
    "wrangler": "^4.160.0"
  },
  "allowScripts": {
    "@tailwindcss/oxide@4.1.14": true,
    "sharp@0.34.5": true
  }
}
