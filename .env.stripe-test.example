# ---------------------------------------------------------------------------
# StreamingHub – Stripe test-mode environment (NEVER commit the filled copy)
#
# Copy to .env.stripe-test, add test-mode values and load them into the shell:
#
#   cp .env.stripe-test.example .env.stripe-test
#   set -a; . ./.env.stripe-test; set +a
#   npm run dev
#
#   # second terminal, same variables:
#   set -a; . ./.env.stripe-test; set +a
#   npm run stripe:live-test
#
# Only test keys (sk_test_...). Never put live keys in a test environment.
# ---------------------------------------------------------------------------

APP_URL=http://127.0.0.1:3000
SMOKE_BASE_URL=http://127.0.0.1:3000

STRIPE_SECRET_KEY=sk_test_
# Recurring monthly price, 2,49 EUR, tax-inclusive (created in the Stripe dashboard).
STRIPE_PRICE_ID=price_
# From `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
STRIPE_WEBHOOK_SECRET=whsec_
# Optional: only for a Stripe-compatible proxy or the local stub.
# STRIPE_API_BASE=https://api.stripe.com
# STRIPE_TIMEOUT_MS=10000
